# Root .dockerignore — governs BOTH app images, whose build context is the
# repo root (see mcp-app/Dockerfile and pipeline-app/Dockerfile:
# `docker build -f <app>/Dockerfile .`). Each Dockerfile only COPYs what it
# needs; these rules just keep the uploaded context lean.

# VCS + caches
.git/
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Not needed in any runtime image
tests/
docs/
.scratch/
.agents/
skills-lock.json
AGENTS.md
MISSION.md
NOTES.md
RESOURCES.md
package-lock.json

# Runtime state lives in each app's own mounted data volume
# (mcp-app/data, pipeline-app/data -> /app/data); never in an image.
mcp-app/data/
pipeline-app/data/
output/

# Secrets
.env
*.log
