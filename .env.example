# Copy to .env and fill in.
# Used by the stage-2 LLM judge (OpenAI-compatible API) and shared with the
# podcastfy audio backend (TNG qwen3 TTS reuses it as a bearer token).
SKAINET_API_KEY=

# --- Podcastfy audio backend ------------------------------------------------
# The LLM endpoint + model used for transcript generation. Defaults to the
# SkaiNet/tngtech gateway.
LLM_API_BASE=https://chat.model.tngtech.com/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# --- Scheduler --------------------------------------------------------------
# Set to false to start with the weekly auto-run disabled (recommended for
# local testing). Toggle at runtime via the UI switch.
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 9 * * fri
