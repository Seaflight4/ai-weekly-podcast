# Copy to .env and fill in.
# Used by the stage-2 LLM judge (OpenAI-compatible API) and shared with the
# podcastfy audio backend (TNG qwen3 TTS reuses it as a bearer token).
SKAINET_API_KEY=

# --- Podcastfy audio backend ------------------------------------------------
# The LLM endpoint used for transcript generation (SkaiNet/tngtech gateway).
# The transcript model is pinned to deepseek-ai/DeepSeek-V4-Flash-0731 in
# podcast_engine/generator.py (DEFAULT_MODEL) — it is NOT configurable via env
# (a heavier reasoning model's thinking preamble truncates the JSON and
# forces empty/1-turn retries).
LLM_API_BASE=https://chat.model.tngtech.com/v1

# Note: there is no scheduled auto-run anymore — episodes are generated from
# the web UI only (docker compose up, then http://localhost:8000). The CLI
# (`python -m pipeline run`) is an internal/dev-only interface used by the
# service to run jobs; it is not a supported way to generate episodes. All
# other settings live in data/podcast_config.yaml (edit via the Settings
# dialog).
