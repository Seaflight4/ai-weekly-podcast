# --- Python ---
.venv/
__pycache__/
*.pyc
*.egg-info/

# --- Secrets ---
.env

# --- Runtime data ---
# This app's own data/ folder (job DB, source PDFs, generated episodes,
# caches) is the Docker /app/data bind mount and stays local.
# Only data/.gitkeep is tracked so a fresh clone has a real directory.
/data/*
!/data/.gitkeep
