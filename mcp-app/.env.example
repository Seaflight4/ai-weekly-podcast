# Copy to .env and fill in.
# Used by the podcast engine's transcript LLM (OpenAI-compatible API) and
# shared with the podcastfy audio backend (TNG qwen3 TTS reuses it as a
# bearer token).
SKAINET_API_KEY=

# --- Podcastfy audio backend ------------------------------------------------
# The LLM endpoint used for transcript generation (SkaiNet/tngtech gateway).
# The transcript model is pinned in podcast_engine/generator.py (DEFAULT_MODEL)
# — it is NOT configurable via env.
LLM_API_BASE=https://chat.model.tngtech.com/v1
