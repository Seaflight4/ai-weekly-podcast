# --- Python ---
.venv/
__pycache__/
*.pyc
*.egg-info/

# --- Runtime data ---
# Per-app runtime state is ignored by each app's own .gitignore
# (mcp-app/data, pipeline-app/data). Here we just ignore stray engine
# cwd-relative output/ dirs in case code runs outside an app folder.
output/

# --- Whisper model cache (one-off ASR verifier) ---
/.hf-cache/

# --- Secrets ---
.env

# --- Teaching workspace (kept locally, excluded from the public repo) ---
# Anchored to repo root so they don't match vendored package data.
AGENTS.md
skills-lock.json
/.agents/
/docs/
/.scratch/

# --- Editors / OS ---
.idea/
.vscode/
*.log
.DS_Store
