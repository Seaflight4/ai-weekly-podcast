# --- Python ---
.venv/
__pycache__/
*.pyc
*.egg-info/

# --- Runtime data ---
# Example run output IS tracked (e.g. data/default/<Friday>/), but per-run
# caches, the service's job logs + scheduler config + the personalized
# library, and podcastfy's default output dirs are regenerable, so keep them
# out.
data/**/.podcastfy-cache/
data/.jobs/
data/.schedule.json
data/personalized/
output/

# --- Secrets ---
.env

# --- Teaching workspace (kept locally, excluded from the public repo) ---
# Anchored to repo root so they don't match vendored package data.
AGENTS.md
skills-lock.json
/.agents/
/docs/
/.scratch/

# --- Editors / OS ---
.idea/
.vscode/
*.log
.DS_Store
