# --- Python ---
.venv/
__pycache__/
*.pyc
*.egg-info/

# --- Runtime data ---
# Everything under data/ is per-machine runtime state (episode history,
# persisted podcast config, job logs, caches) served through the ./data bind
# mount — it stays local, nothing under data/ is tracked.
/data/
output/

# --- Whisper model cache (one-off ASR verifier) ---
/.hf-cache/

# --- Secrets ---
.env

# --- Teaching workspace (kept locally, excluded from the public repo) ---
# Anchored to repo root so they don't match vendored package data.
AGENTS.md
skills-lock.json
/.agents/
/docs/
/.scratch/

# --- Editors / OS ---
.idea/
.vscode/
*.log
.DS_Store
